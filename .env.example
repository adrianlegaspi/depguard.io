# === Server-side (Vercel function only — DO NOT prefix with EXPO_PUBLIC_) ===
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel KV (auto-populated when you add the KV integration in Vercel dashboard).
# For local dev with `vercel dev`, run `vercel env pull .env` after linking the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === Client-side (bundled into app — safe to expose) ===
# Leave empty for same-origin web (defaults to /api/recommendations).
# Set absolute URL for native iOS/Android builds, e.g. https://depguard.io/api/recommendations
EXPO_PUBLIC_RECOMMENDATIONS_API_URL=
