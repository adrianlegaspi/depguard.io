# === Server-side (Vercel function only — DO NOT prefix with EXPO_PUBLIC_) ===
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# === Vercel Redis / Upstash (via Vercel Marketplace integration) ===
# Auto-populated by Vercel in prod. For local dev:
#   1. `vercel link` (link to project)
#   2. `vercel env pull .env` (downloads all vars below)
#
# REST API (used by upstash-redis Python SDK in api/recommendations.py):
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# TCP connection strings (not used by current code, but Vercel provides them
# — keep documented so `vercel env pull` doesn't surprise anyone):
KV_URL=
REDIS_URL=

# === Client-side (bundled into app — safe to expose) ===
# Leave empty for same-origin web (defaults to /api/recommendations).
# Set absolute URL for native iOS/Android builds, e.g. https://depguard.io/api/recommendations
EXPO_PUBLIC_RECOMMENDATIONS_API_URL=
