{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/recommendations.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/results/:id", "destination": "/results/[id]" }
  ]
}
