{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/recommendations.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 30,
      "excludeFiles": "{node_modules/**,dist/**,.expo/**,.vercel/**,.claude/**,app/**,assets/**,components/**,hooks/**,lib/**,services/**,*.config.js,package.json,pnpm-lock.yaml,tsconfig.json,app.json,global.css,*.md}"
    }
  },
  "rewrites": [
    { "source": "/results/:id", "destination": "/results/[id].html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
