{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm exec expo export --platform web",
  "outputDirectory": "dist",
  "functions": {
    "api/recommendations.py": {
      "runtime": "@vercel/python@4.3.1",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "^/results/([^/]+)$", "dest": "/results/[id].html" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
